{
  "name": "breadrelay",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "npm run typecheck && vite build",
    "preview": "node scripts/serve-static.mjs",
    "check:browser": "node scripts/browser-check.mjs && node scripts/core-check.mjs",
    "check:core": "node scripts/core-check.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "evaluate": "node --experimental-strip-types scripts/evaluate-baselines.ts",
    "check:webkit": "node scripts/webkit-check.mjs",
    "check:improvements": "node scripts/improvement-check.mjs",
    "check:production": "node scripts/production-check.mjs"
  },
  "devDependencies": {
    "vite": "8.3.2",
    "typescript": "7.0.2",
    "@types/node": "22.18.0",
    "playwright": "1.62.1"
  },
  "license": "UNLICENSED"
}
